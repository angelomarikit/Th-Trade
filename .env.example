# Alpaca market data + news (official API — data only, no order execution)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_NEWS_BASE_URL=https://data.alpaca.markets

# News provider: mock | alpaca
NEWS_PROVIDER=mock

# Market data provider: alpaca | mock
MARKET_DATA_PROVIDER=alpaca
ALPACA_DATA_FEED=iex

# Feature flags — options engine stays OFF until underlying validated
FEATURE_OPTIONS_ENGINE=false
OPTIONS_PROVIDER=mock
ALPACA_OPTIONS_FEED=indicative

# Journal store: sqlite | memory
JOURNAL_STORE=sqlite

# API
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Phase 2 — server-side multi-stock monitor (runs inside Railway API process)
MONITOR_MAX_SYMBOLS=6
MONITOR_INTERVAL_MS=20000

# Verified account value for position sizing (never use paper balance)
VERIFIED_ACCOUNT_VALUE=

# ——— Supabase (Auth + profiles/credits) ———
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe anon key (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ——— OpenAI (AI narrative on top of rule-based recommendation) ———
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ——— Stripe (later) ———
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_STANDARD=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_ULTRA=
# STRIPE_WEBHOOK_SECRET=

# Web (optional; leave empty to use Vite proxy in dev)
# VITE_API_BASE=http://localhost:8787
